<Project Sdk="WixToolset.Sdk/5.0.2">

  <!--
    Per-user MSI: no administrator prompt, installs to %LOCALAPPDATA%\Programs\Enhanced Snap.
    Build through ../build.ps1, which publishes the apps first and passes PublishDir/ProductVersion.
    WiX v5 is used deliberately (MS-RL licensed, no maintenance-fee EULA).
  -->
  <PropertyGroup>
    <ProductVersion Condition="'$(ProductVersion)' == ''">$(Version)</ProductVersion>
    <InstallerPlatform Condition="'$(InstallerPlatform)' == ''">x64</InstallerPlatform>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)..\artifacts\publish\win-x64\</PublishDir>
    <OutputName>EnhancedSnap-$(ProductVersion)-$(InstallerPlatform)</OutputName>
    <DefineConstants>ProductVersion=$(ProductVersion);PublishDir=$(PublishDir);AssetsDir=$(MSBuildThisFileDirectory)..\assets\</DefineConstants>
    <!-- Per-user installs into the profile: file key paths and profile folders are intended (ICE38/64/91).
         ICE03: some Windows App SDK resource DLLs carry language ids MSI's File table rejects; irrelevant here
         (that column only drives language-specific installs) and it made builds flaky. -->
    <SuppressIces>ICE03;ICE38;ICE64;ICE91</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>

</Project>
