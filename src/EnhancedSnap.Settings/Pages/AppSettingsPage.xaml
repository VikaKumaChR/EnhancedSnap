<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings, NavigationView's own item at the bottom of the pane: how the app itself looks and talks, and the About
    section. Laid out by learn.microsoft.com/windows/apps/design/app-settings/guidelines-for-app-settings: SettingsCards
    under section headers, web links as clickable cards with an external-link icon, About last as a SettingsExpander
    whose header shows the name, icon and version.
-->
<Page
    x:Class="EnhancedSnap.Settings.Pages.AppSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EnhancedSnap.Settings.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer>
        <controls:PageContentPanel>
        <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
            <TextBlock Margin="0,24,0,0" Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind S.Nav_Settings}" />
            <TextBlock Margin="0,4,0,16" Style="{StaticResource PageDescriptionTextBlockStyle}" Text="{x:Bind S.Settings_Desc}" />

            <!-- App appearance: theme of this window, and its language (moved here from General). -->
            <TextBlock Style="{StaticResource SectionHeaderTextBlockStyle}" Text="{x:Bind S.Section_AppAppearance}" />
            <toolkit:SettingsCard Description="{x:Bind S.Setting_ThemeDesc}" Header="{x:Bind S.Setting_Theme}">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE790;" /></toolkit:SettingsCard.HeaderIcon>
                <ComboBox MinWidth="240" SelectedIndex="{x:Bind Vm.ThemeIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{x:Bind S.Theme_System}" />
                    <ComboBoxItem Content="{x:Bind S.Theme_Light}" />
                    <ComboBoxItem Content="{x:Bind S.Theme_Dark}" />
                </ComboBox>
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Description="{x:Bind S.Setting_LanguageDesc}" Header="{x:Bind S.Setting_Language}">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE775;" /></toolkit:SettingsCard.HeaderIcon>
                <ComboBox MinWidth="240" SelectedIndex="{x:Bind Vm.LanguageIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{x:Bind S.Language_System}" />
                    <ComboBoxItem Content="English" />
                    <ComboBoxItem Content="繁體中文" />
                    <ComboBoxItem Content="简体中文" />
                </ComboBox>
            </toolkit:SettingsCard>

            <!-- About: feedback and the former About page's tools, then the About expander, last on the page. -->
            <TextBlock Style="{StaticResource SectionHeaderTextBlockStyle}" Text="{x:Bind S.Section_About}" />
            <controls:ClickableSettingsCard Click="Feedback_Click" Description="{x:Bind S.Feedback_Desc}" Header="{x:Bind S.Feedback_Title}">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xED15;" /></toolkit:SettingsCard.HeaderIcon>
                <toolkit:SettingsCard.ActionIcon><FontIcon Glyph="&#xE8A7;" /></toolkit:SettingsCard.ActionIcon>
            </controls:ClickableSettingsCard>
            <controls:ClickableSettingsCard Click="OpenLogs_Click" Header="{x:Bind S.About_OpenLogs}">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8A5;" /></toolkit:SettingsCard.HeaderIcon>
            </controls:ClickableSettingsCard>
            <controls:ClickableSettingsCard Click="OpenData_Click" Header="{x:Bind S.About_OpenData}">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE838;" /></toolkit:SettingsCard.HeaderIcon>
            </controls:ClickableSettingsCard>
            <toolkit:SettingsCard Header="{x:Bind S.About_Quit}">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7E8;" /></toolkit:SettingsCard.HeaderIcon>
                <Button Click="Quit_Click" Content="{x:Bind S.Tray_Quit}" />
            </toolkit:SettingsCard>

            <toolkit:SettingsExpander x:Name="AboutExpander" Description="{x:Bind S.About_Copyright}" Header="{x:Bind S.AppName}">
                <toolkit:SettingsExpander.HeaderIcon>
                    <ImageIcon Source="ms-appx:///Assets/AppIcon-48.png" />
                </toolkit:SettingsExpander.HeaderIcon>
                <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard HorizontalContentAlignment="Left" ContentAlignment="Left">
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind S.About_Desc}" TextWrapping="Wrap" />
                    </toolkit:SettingsCard>
                    <controls:ClickableSettingsCard Click="License_Click" Description="{x:Bind S.About_LicenseDesc}" Header="{x:Bind S.About_License}">
                        <toolkit:SettingsCard.ActionIcon><FontIcon Glyph="&#xE8A7;" /></toolkit:SettingsCard.ActionIcon>
                    </controls:ClickableSettingsCard>
                    <controls:ClickableSettingsCard Click="ThirdParty_Click" Description="{x:Bind S.About_ThirdPartyDesc}" Header="{x:Bind S.About_ThirdParty}">
                        <toolkit:SettingsCard.ActionIcon><FontIcon Glyph="&#xE8A7;" /></toolkit:SettingsCard.ActionIcon>
                    </controls:ClickableSettingsCard>
                    <controls:ClickableSettingsCard Click="Privacy_Click" Description="{x:Bind S.About_PrivacyDesc}" Header="{x:Bind S.About_Privacy}">
                        <toolkit:SettingsCard.ActionIcon><FontIcon Glyph="&#xE8A7;" /></toolkit:SettingsCard.ActionIcon>
                    </controls:ClickableSettingsCard>
                    <controls:ClickableSettingsCard Click="Repository_Click" Description="{x:Bind S.About_RepoDesc}" Header="{x:Bind S.About_Repo}">
                        <toolkit:SettingsCard.ActionIcon><FontIcon Glyph="&#xE8A7;" /></toolkit:SettingsCard.ActionIcon>
                    </controls:ClickableSettingsCard>
                    <toolkit:SettingsCard Description="{x:Bind S.About_EnergyBody}" Header="{x:Bind S.About_Energy}" />
                    <toolkit:SettingsCard Description="{x:Bind S.About_RoadmapBody}" Header="{x:Bind S.About_Roadmap}" />
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>
        </StackPanel>
        </controls:PageContentPanel>
    </ScrollViewer>
</Page>
