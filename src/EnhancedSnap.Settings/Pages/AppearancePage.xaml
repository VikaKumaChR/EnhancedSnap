<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EnhancedSnap.Settings.Pages.AppearancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EnhancedSnap.Settings.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer>
        <Grid Margin="{StaticResource PageContentMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="{StaticResource PageMaxWidth}" />
            </Grid.ColumnDefinitions>
        <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
            <TextBlock Margin="0,24,0,0" Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind S.Nav_Appearance}" />
            <TextBlock Margin="0,4,0,16" Style="{StaticResource PageDescriptionTextBlockStyle}" Text="{x:Bind S.Appearance_Desc}" />

            <InfoBar x:Name="EnergyBar" Margin="0,0,0,8" IsClosable="False" Message="{x:Bind S.Energy_Body}" Severity="Informational" Title="{x:Bind S.Energy_Title}" />
            <InfoBar x:Name="TransparencyBar" Margin="0,0,0,8" IsClosable="False" Message="{x:Bind S.Transparency_Off}" Severity="Informational" />

            <!-- Live preview: a scaled-down desktop with the current layout, spacing and corner radius. -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}">
                <StackPanel Spacing="10">
                    <!-- No fixed height: the preview keeps the display's aspect ratio and scales with the window. -->
                    <Border
                        MaxHeight="380"
                        HorizontalAlignment="Center"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource OverlayCornerRadius}">
                        <controls:LayoutPreview x:Name="Preview" ReferenceWidthEpx="1000" ShowWindows="True" />
                    </Border>
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind S.Preview_Caption}" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeaderTextBlockStyle}" Text="{x:Bind S.Section_Spacing}" />
            <toolkit:SettingsCard Description="{x:Bind S.Setting_GapDesc}" Header="{x:Bind S.Setting_Gap}">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xECA5;" /></toolkit:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Slider Width="220" VerticalAlignment="Center" Maximum="32" Minimum="0" SnapsTo="StepValues" StepFrequency="2" TickFrequency="4" TickPlacement="Outside" Value="{x:Bind Vm.Gap, Mode=TwoWay}" />
                    <TextBlock Width="48" VerticalAlignment="Center" Text="{x:Bind Vm.GapText, Mode=OneWay}" />
                </StackPanel>
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Description="{x:Bind S.Setting_MarginDesc}" Header="{x:Bind S.Setting_Margin}">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE740;" /></toolkit:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Slider Width="220" VerticalAlignment="Center" Maximum="32" Minimum="0" SnapsTo="StepValues" StepFrequency="2" TickFrequency="4" TickPlacement="Outside" Value="{x:Bind Vm.Margin, Mode=TwoWay}" />
                    <TextBlock Width="48" VerticalAlignment="Center" Text="{x:Bind Vm.MarginText, Mode=OneWay}" />
                </StackPanel>
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Description="{x:Bind S.Setting_CornersDesc}" Header="{x:Bind S.Setting_Corners}">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE799;" /></toolkit:SettingsCard.HeaderIcon>
                <ComboBox MinWidth="240" SelectedIndex="{x:Bind Vm.CornersIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{x:Bind S.Corners_Round}" />
                    <ComboBoxItem Content="{x:Bind S.Corners_Small}" />
                    <ComboBoxItem Content="{x:Bind S.Corners_System}" />
                </ComboBox>
            </toolkit:SettingsCard>

            <TextBlock Style="{StaticResource SectionHeaderTextBlockStyle}" Text="{x:Bind S.Section_Effects}" />
            <toolkit:SettingsCard Description="{x:Bind S.Setting_MaterialDesc}" Header="{x:Bind S.Setting_Material}">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE771;" /></toolkit:SettingsCard.HeaderIcon>
                <ComboBox MinWidth="240" SelectedIndex="{x:Bind Vm.MaterialIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{x:Bind S.Material_Auto}" />
                    <ComboBoxItem Content="{x:Bind S.Material_Solid}" />
                </ComboBox>
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Description="{x:Bind S.Setting_MotionDesc}" Header="{x:Bind S.Setting_Motion}">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE768;" /></toolkit:SettingsCard.HeaderIcon>
                <ComboBox MinWidth="240" SelectedIndex="{x:Bind Vm.MotionIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{x:Bind S.Motion_Auto}" />
                    <ComboBoxItem Content="{x:Bind S.Motion_Off}" />
                </ComboBox>
            </toolkit:SettingsCard>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
